  <diagram name="Página-1" id="hpjSuNl6mxF8o7U4bl8R">
    <mxGraphModel dx="4098" dy="1908" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ================= ENTIDADES =================\n    PERSONA[PERSONA]\n    EMPLEADO[EMPLEADO]\n    CLIENTE[CLIENTE]\n    ARTISTA[ARTISTA]\n    DEPARTAMENTO[DEPARTAMENTO]\n    EVENTO[EVENTO]\n    ESPACIO[ESPACIO]\n    ACTIVIDAD[[ACTIVIDAD]]\n    CONTRATACION[CONTRATACION]\n\n    %% ================= JERARQUIA DE PERSONA =================\n    %% Especialización Total (Círculo) y Disjunta (Arco)\n    TOTAL(( ))\n    PERSONA --- TOTAL\n    ISA{\&quot; \&quot;}\n    TOTAL --- ISA\n    ISA -- \&quot;arco disjunto\&quot; --- EMPLEADO\n    ISA -- \&quot;arco disjunto\&quot; --- CLIENTE\n    ISA -- \&quot;arco disjunto\&quot; --- ARTISTA\n\n    %% ================= RELACIONES =================\n    RSUP{\&quot;supervisa\\n1:N\&quot;}\n    RPERT{\&quot;pertenece\\n1:N\&quot;}\n    RDIR{\&quot;dirige\\n1:1\&quot;}\n    RORG{\&quot;organiza\\n1:N\&quot;}\n    RALB{\&quot;alberga\\n1:N\&quot;}\n    RCOMP{\&quot;E\\ncompuesto por\\n1:N\&quot;}\n    RPAR{\&quot;participa\\nM:N\&quot;}\n    RREA{\&quot;realiza\\n1:N\&quot;}\n    RINC{\&quot;incluye\\nM:N\&quot;}\n    RASI{\&quot;asignado a\\nM:N\&quot;}\n\n    %% ================= CONEXIONES Y CARDINALIDADES =================\n\n    %% Empleado supervisa Empleado (Reflexiva 1:N)\n    %% Un supervisor tiene (0,n) empleados, un empleado tiene (0,1) supervisor\n    EMPLEADO -- \&quot;(0,1)\&quot; --- RSUP\n    RSUP -- \&quot;(0,n)\&quot; --&gt; EMPLEADO\n\n    %% Empleado pertenece Departamento (1:N)\n    %% Un departamento tiene (1,n) empleados, un empleado pertenece a (1,1) departamento\n    DEPARTAMENTO -- \&quot;(1,1)\&quot; --- RPERT\n    RPERT -- \&quot;(1,n)\&quot; --&gt; EMPLEADO\n\n    %% Empleado dirige Departamento (1:1)\n    DEPARTAMENTO -- \&quot;(0,1)\&quot; --- RDIR\n    RDIR -- \&quot;(1,1)\&quot; --- EMPLEADO\n\n    %% Departamento organiza Evento (1:N)\n    DEPARTAMENTO -- \&quot;(1,1)\&quot; --- RORG\n    RORG -- \&quot;(0,n)\&quot; --&gt; EVENTO\n\n    %% Espacio alberga Evento (1:N)\n    ESPACIO -- \&quot;(1,1)\&quot; --- RALB\n    RALB -- \&quot;(0,n)\&quot; --&gt; EVENTO\n\n    %% Evento compuesto por Actividad (Entidad Débil 1:N)\n    EVENTO -- \&quot;(1,1)\&quot; --- RCOMP\n    RCOMP -- \&quot;(1,n)\&quot; --&gt; ACTIVIDAD\n\n    %% Artista participa Evento (M:N)\n    ARTISTA &lt;-- \&quot;(0,n)\&quot; --- RPAR\n    RPAR -- \&quot;(0,n)\&quot; --&gt; EVENTO\n\n    %% Cliente realiza Contratación (1:N)\n    CLIENTE -- \&quot;(1,1)\&quot; --- RREA\n    RREA -- \&quot;(0,n)\&quot; --&gt; CONTRATACION\n\n    %% Contratación incluye Evento (M:N)\n    CONTRATACION &lt;-- \&quot;(0,n)\&quot; --- RINC\n    RINC -- \&quot;(1,n)\&quot; --&gt; EVENTO\n\n    %% Empleado asignado a Evento (M:N)\n    EMPLEADO &lt;-- \&quot;(0,n)\&quot; --- RASI\n    RASI -- \&quot;(0,n)\&quot; --&gt; EVENTO\n\n    %% ================= ATRIBUTOS DE RELACIONES =================\n    \n    %% Atributos de \&quot;participa\&quot;\n    PAR_FCO([fecha_confirmacion])\n    PAR_CAC([cache_acordado])\n    PAR_HAC([hora_actuacion])\n    PAR_DAC([duracion_actuacion])\n    PAR_OBS([observaciones])\n    RPAR --- PAR_FCO &amp; PAR_CAC &amp; PAR_HAC &amp; PAR_DAC &amp; PAR_OBS\n\n    %% Atributos de \&quot;incluye\&quot;\n    INC_PRE([precio_acordado])\n    INC_DES([descuento_aplicado])\n    INC_OBS([observaciones])\n    RINC --- INC_PRE &amp; INC_DES &amp; INC_OBS\n\n    %% Atributos de \&quot;asignado a\&quot;\n    ASI_FAS([fecha_asignacion])\n    ASI_FUN([funcion_desempenada])\n    ASI_HPR([horas_previstas])\n    ASI_HRE([horas_realizadas])\n    RASI --- ASI_FAS &amp; ASI_FUN &amp; ASI_HPR &amp; ASI_HRE\n\n    %% ================= ATRIBUTOS DE ENTIDADES =================\n    \n    %% PERSONA\n    P_ID([\&quot;&lt;u&gt;id&lt;/u&gt;\&quot;])\n    P_NOM([nombre])\n    P_APE([apellidos])\n    P_FNA([fecha_nacimiento])\n    P_DNI([DNI])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="B4XxKKGb0KbyoGOGVDKz-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
